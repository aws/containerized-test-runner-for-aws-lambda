{
    "tests": [
        {
            "name": "test_ping",
            "handler": "core.ping",
            "environmentVariables": {
                "TEST_ENVIRONMENT_VARIABLE": "test_env"
            },
            "request": {
                "msg": "message"
            },
            "assertions": [
                {
                    "response": {
                        "msg": "pong[message]"
                    }
                }
            ]
        },
        {
            "name": "test_ping2",
            "handler": "core.ping",
            "environmentVariables": {
                "TEST_ENVIRONMENT_VARIABLE": "test_env"
            },
            "request": {
                "msg": "message"
            },
            "assertions": [
                {
                    "response": {
                        "msg": "pong[message]"
                    }
                }
            ]
        },
        {
            "name": "test_client_context_custom_is_delivered",
            "handler": "core.echoClientContextCustom",
            "request": {},
            "clientContext": {
                "custom": {
                    "value": "hello"
                }
            },
            "assertions": [
                {
                    "response": {
                        "custom": {
                            "value": "hello"
                        }
                    }
                }
            ]
        }
    ]
}